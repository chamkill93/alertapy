# Plantilla de producción; completar solamente en el servidor, fuera de public/.
# APP_KEY se genera una vez con artisan key:generate después de instalar Composer.
# Completar DB_* con los valores reales de hPanel; no contiene credenciales.
APP_NAME=AlertaPY
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.alertaparaguay.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Asuncion
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=alertaparaguay-session
SESSION_PATH=/
# null limita la cookie al host que inicia la sesión; no comparte subdominios.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# El correo saliente queda pendiente de un proveedor y remitente verificados.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# El cron usa scripts/run-cycle.sh por CLI; estas integraciones son opcionales.
# El login del backoffice usa un usuario administrador y no estos tokens.
ALERTAPY_CRON_SECRET=
ALERTAPY_ADMIN_TOKEN=
ALERTAPY_CYCLE_MAX_SECONDS=180
ALERTAPY_MAX_SOURCES_PER_CYCLE=20
ALERTAPY_MAX_CANDIDATES_PER_CYCLE=100
ALERTAPY_MAX_AI_DECISIONS_PER_CYCLE=50
ALERTAPY_SCHEDULER_STALE_MINUTES=15
ALERTAPY_MAX_INCIDENTS_PER_REQUEST=200
ALERTAPY_SOURCE_TIMEOUT=15
ALERTAPY_SOURCE_USER_AGENT="AlertaPY/1.0 (+https://www.alertaparaguay.com)"
ALERTAPY_LOCAL_RULES_PUBLISH=true
ALERTAPY_OFFICIAL_SOURCES_PUBLISH=true
ALERTAPY_DECISION_PROVIDER=rules
ALERTAPY_ROUTE_DATA_ENABLED=true
ALERTAPY_ROAD_DUPLICATE_KM_TOLERANCE=1.0
ALERTAPY_ROAD_MAX_SEGMENT_LENGTH_METERS=100000
ALERTAPY_ROAD_INTERSECTION_TOLERANCE_METERS=80
ALERTAPY_MAX_FAVORITE_ZONES=10
ALERTAPY_DEFAULT_FAVORITE_RADIUS_KM=3
ALERTAPY_MAX_FAVORITE_RADIUS_KM=25

OPENCODE_ENABLED=false
OPENCODE_DECISION_URL=
OPENCODE_DECISION_TOKEN=
OPENCODE_DECISION_TIMEOUT=30

GEOCODING_PROVIDER=nominatim
GEOCODING_USER_AGENT="AlertaPY/1.0 (+https://www.alertaparaguay.com)"
REPORT_CAPTCHA_ENABLED=false

SOURCE_ANDE_ENABLED=true
SOURCE_ANDE_MAX_ARTICLES=250
SOURCE_ANDE_MAX_PAGES=5
SOURCE_SENEPA_ENABLED=true
SOURCE_ESSAP_ENABLED=true
SOURCE_ESSAP_API_URL=https://www.essap.com.py/wp-json/wp/v2/posts
SOURCE_ESSAP_CATEGORY_IDS=6,7,34,35
SOURCE_ESSAP_MAX_AGE_HOURS=168
SOURCE_ESSAP_PAGE_SIZE=100
SOURCE_ESSAP_MAX_PAGES=5
SOURCE_ESSAP_MAX_CANDIDATES=250
SOURCE_METEOROLOGIA_ENABLED=true
SOURCE_INFONA_ENABLED=true
SOURCE_MADES_ENABLED=true
SOURCE_SIAGUAPY_ENABLED=true
SOURCE_MOPC_ENABLED=true
SOURCE_SEN_ENABLED=true
SOURCE_MSPBS_HEALTH_ENABLED=true
SOURCE_DGVS_ENABLED=true
SOURCE_ERSSAN_ENABLED=true
SOURCE_SENACSA_ENABLED=true
SOURCE_MIGRACIONES_ENABLED=true
SOURCE_DINAC_ENABLED=true

# Activar las fuentes que requieren claves solo después de recibirlas.
MADES_AIR_API_KEY=
MADES_AIR_API_URL=https://calidadaire.mades.gov.py/api/v1
NASA_FIRMS_MAP_KEY=
NASA_FIRMS_ENABLED=false
NASA_FIRMS_API_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv
NASA_FIRMS_SOURCE=VIIRS_NOAA20_NRT
NASA_FIRMS_BBOX=-62.7,-27.7,-54.2,-19.1
NASA_FIRMS_DAY_RANGE=2
FIRE_CORRELATION_DISTANCE_KM=15
FIRE_CORRELATION_WINDOW_HOURS=24

SOURCE_ABC_ENABLED=true
SOURCE_ABC_FEED_URL=https://www.abc.com.py/arc/outboundfeeds/rss/nacionales/
SOURCE_ABC_ARCHIVE_URL=https://www.abc.com.py/pf/api/v3/content/fetch/sections-api
SOURCE_ABC_ARCHIVE_PAGE_SIZE=100
SOURCE_ABC_ARCHIVE_MAX_PAGES=20
SOURCE_ABC_ARCHIVE_MAX_CANDIDATES=500
SOURCE_ABC_MAX_AGE_HOURS=48
SOURCE_ABC_MAX_CANDIDATES=30
SOURCE_ULTIMAHORA_ENABLED=true
SOURCE_ULTIMAHORA_MAX_AGE_HOURS=72
SOURCE_ULTIMAHORA_MAX_LINKS=120
SOURCE_ULTIMAHORA_MAX_CANDIDATES=30
SOURCE_LANACION_ENABLED=true
SOURCE_LANACION_MAX_AGE_HOURS=72
SOURCE_LANACION_MAX_LINKS=100
SOURCE_LANACION_MAX_CANDIDATES=25
SOURCE_HOY_ENABLED=true
SOURCE_POPULAR_ENABLED=true
SOURCE_EXTRA_ENABLED=true
SOURCE_LATRIBUNA_ENABLED=true
SOURCE_1000NOTICIAS_ENABLED=true
SOURCE_NANDUTI_ENABLED=true
SOURCE_UNICANAL_ENABLED=false

# Discovery produce candidatos para revisión; se habilita con claves válidas.
GDELT_ENABLED=false
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_TIMESPAN=24h
GDELT_MAX_RESULTS=50
GDELT_TIMEOUT=30
X_DISCOVERY_ENABLED=false
X_BEARER_TOKEN=
BLUESKY_DISCOVERY_ENABLED=false
BLUESKY_API_URL=https://public.api.bsky.app/xrpc/app.bsky.feed.searchPosts
MASTODON_DISCOVERY_ENABLED=false
MASTODON_INSTANCES=
MASTODON_HASHTAGS=Paraguay,Asuncion
TELEGRAM_DISCOVERY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNELS=
YOUTUBE_DISCOVERY_ENABLED=false
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_IDS=
